import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

android_library("java") {
  sources = [
    "java/src/org/chromium/chrome/browser/autofill/BraveAutofillClientProviderUtils.java",
    "java/src/org/chromium/chrome/browser/autofill/options/BraveAutofillOptionsFragment.java",
  ]

  srcjar_deps = [ "//brave/browser/android/preferences:java_pref_names_srcjar" ]

  deps = [
    "//base:base_java",
    "//brave/build/android:android_brave_strings_grd",
    "//chrome/browser/autofill/android:java",
    "//chrome/browser/preferences:java",
    "//chrome/browser/profiles/android:java",
    "//chrome/browser/settings:java",
    "//components/browser_ui/settings/android:java",
    "//components/prefs/android:java",
    "//components/user_prefs/android:java",
    "//content/public/android:content_full_java",
    "//third_party/androidx:androidx_preference_preference_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}

generate_jni("jni_headers") {
  sources = [ "java/src/org/chromium/chrome/browser/autofill/BraveAutofillClientProviderUtils.java" ]
}
